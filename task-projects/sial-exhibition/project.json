  "updates": [
    {
      "date": "2026-10-21",
      "title": "بحث الوكالات السعودية وتحسين ملفات الشركات",
      "detail": "توحيد تصميم ملفات الشركات وإضافة بحث الوكيل الحصري في السعودية بالمصادر، مع فصل التوزيع المعلن عن الحصرية غير المثبتة. شمل 45 ملفًا وشورتوك."
    },
    {
      "date": "2026-10-21",
      "title": "استكمال صور وبطاقات شركات سيال",
      "detail": "إضافة 57 صورة وبطاقة إلى 15 ملفًا: 12 ملف شركة وعلامة جديدًا، وتحديث Cocomax وMOKATE وXOXO دون تكرار الشركات."
    },
    {
      "date": "2026-10-19",
      "title": "شركة شورتوك — حفظ تقرير المطابقة والصورتين",
      "detail": "مطابقة توزيع حاويتين بإجمالي 50 طبلية و46,890 عبوة؛ توضيحات مطلوبة بشأن أساس النسب وعبارة سنة وتواريخ الإنتاج. ليست موافقة شراء."
    },
    {
      "date": "2026-10-19",
      "title": "18 صورة جديدة — 6 ملفات شركات",
      "detail": "إضافة 18 صورة من أ. مهند إلى 6 ملفات: PERIDOT وALLEGRO/IFFCO وVIVER وborchers/Xucker وPROZIS وCocomax."
    },
    {
      "date": "2026-10-19",
      "title": "إضافة كتالوج UFF الوارد من أ. مهند",
      "detail": "كتالوج أصلي من 11 صفحة: مشروبات البروتين والكولاجين وFAT BURN وHANGOVER ومياه الأكسجين. تواصل الشركة: info@uff.hr — www.uff.hr. أوصاف الفوائد تخص الشركة المصنعة ولا تمثل تحققًا مستقلاً."
    },
    {
      "date": "2026-10-19",
      "title": "إضافة Excel الشركات والمنتجات الصحية",
      "detail": "110 شركات من الأجندة المقدمة، مع المنتجات والقاعة والجناح وحالة الوكيل بالسعودية. ورقة مستقلة تضم 13 جهة تحتاج مراجعة الأصناف. حالات البيع وعدم العثور على وكيل مفصولة عن وجود موزع معلن."
    },
    {
      "date": "2026-10-18",
      "title": "34 صورة جديدة حتى 17:03 — 7 ملفات جديدة وتحديث LIXR",
      "detail": "Le Labo Dumoulin وBUDDY وKULT وANJ/Gams وUFF وNutriDream/Be More وQNT/LIIFE؛ أضيفت بطاقات التواصل والمنتجات، وصورة أسعار LIXR دون اعتبارها اعتماد شراء."
    },
    {
      "date": "2026-10-18",
      "title": "توضيح مجال ومنتجات جميع الشركات",
      "detail": "إضافة ملخص المجال والمنتجات في كل ملف وفي دليل التواصل، واستكمال ELIXIR وNow Juice وWANA من المصادر الرسمية مع فصلها عن صور المعرض."
    },
    {
      "date": "2026-10-18",
      "title": "مراجعة التواصل لجميع الشركات العشرين",
      "detail": "إضافة دليل موحد وقنوات التواصل الرسمية لكل ملف، مع حفظ جهات المعرض وبيان البيانات غير المؤكدة. لم تُرسل رسائل للشركات."
    },
    {
      "date": "2026-10-18",
      "title": "إضافة Thai Coco — صور اليوم 11:48",
      "detail": "حفظ صورتين أصليتين وإضافة ملف المنتجات وبريد مبيعات التصدير من البطاقة. الإجمالي 20 ملف شركة و52 صورة. الأسعار وشروط التوريد غير واردة."
    },
    {
      "date": "2026-10-17",
      "title": "إضافة PICKS / PERGALĖ — صور الساعة 17:01",
      "detail": "أضيفت 4 صور أصلية للجناح والمنتجات مع ملف مستقل ووسائل التواصل من الموقع الرسمي. أصبح الإجمالي 19 ملفًا و50 صورة؛ بطاقة الصورة مغطاة جزئيًا ولم تُخمن بياناتها."
    },
    {
      "date": "2026-10-17",
      "title": "فرز صور سيال وإعداد ملفات الشركات",
      "detail": "حفظ 46 صورة وإعداد 18 ملفًا ودليل شامل مع أسماء المسؤولين ووسائل التواصل والمنتجات وصور قائمة أسعار Diablo. رُبطت صور الاجتماعات وحالات الدعوات الأحدث دون افتراض انعقادها."
    },
    {
      "date": "2026-10-14",
      "title": "إرسال دعوات الحضور وتحديد موعد السفر",
      "detail": "وفق إفادة المستخدم، تم إرسال دعوات حضور معرض سيال إلى أ. مهند وأ. رامي سعد، وسفرهما إلى فرنسا مقرر غدًا، 15 أكتوبر 2026. لم يُفد بإتمام السفر بعد."
    },
    {
      "date": "2026-10-14",
      "title": "قائمة الشركات وطلبات الاجتماعات",
      "detail": "تجميع الشركات ومواقع العرض وحالات الدعوات من القائمة والصورة المرسلتين؛ لم يحدد تاريخ مستقل لحالات الدعوات."
    }
